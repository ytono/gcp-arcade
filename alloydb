# modules/alloydb_cluster/main.tf

resource "google_alloydb_cluster" "alloydb_cluster" {
  project     = var.project_id
  location    = var.region
  cluster_id  = var.cluster_id
  display_name = var.cluster_display_name

  network_config {
    network = var.network
  }

  initial_user {
    user     = "postgres"
    password = var.user_password
  }

  database_version = var.database_version

  # If secondary_cluster_source_id is provided, this cluster will be a secondary replica.
  # Otherwise, it will be a primary cluster.
  dynamic "secondary_config" {
    for_each = var.secondary_cluster_source_id != null ? [1] : []
    content {
      cluster_name = "projects/${var.project_id}/locations/${var.secondary_cluster_source_region}/clusters/${var.secondary_cluster_source_id}"
    }
  }

  # Add labels for better organization
  labels = {
    environment = "dev"
    managed_by  = "terraform"
    type        = var.secondary_cluster_source_id != null ? "secondary" : "primary"
  }

  # Deletion protection is recommended for production clusters
  deletion_protection = false # Set to true for production environments
}
