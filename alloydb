# modules/alloydb_cluster/variables.tf

variable "project_id" {
  description = "The ID of the Google Cloud project."
  type        = string
}

variable "region" {
  description = "The region where the AlloyDB cluster will be created."
  type        = string
}

variable "cluster_id" {
  description = "The ID of the AlloyDB cluster."
  type        = string
}

variable "cluster_display_name" {
  description = "The display name of the AlloyDB cluster."
  type        = string
  default     = null
}

variable "network" {
  description = "The VPC network to which the AlloyDB cluster will be connected. Format: projects/PROJECT_ID/global/networks/NETWORK_NAME"
  type        = string
}

variable "database_version" {
  description = "The database version of the cluster. E.g., POSTGRES_14"
  type        = string
}

variable "user_password" {
  description = "The password for the default 'postgres' user. This should be a strong password."
  type        = string
  sensitive   = true
}

variable "secondary_cluster_source_id" {
  description = "The ID of the primary cluster for a secondary (replica) cluster. Leave null for a primary cluster."
  type        = string
  default     = null
}

variable "secondary_cluster_source_region" {
  description = "The region of the primary cluster for a secondary (replica) cluster. Required if secondary_cluster_source_id is set."
  type        = string
  default     = null
}
