# clusters.yaml
# 複数のAlloyDBクラスタとインスタンスの定義

clusters:
  # プライマリクラスタの例 (us-central1)
  primary_us_central:
    type: primary
    region: us-central1
    cluster_id: my-primary-us-central-cluster
    display_name: "US Central Primary AlloyDB Cluster"
    instances:
      - instance_id: my-primary-us-central-instance-1
        display_name: "US Central Primary Instance 1"
        instance_type: PRIMARY
        cpu_count: 2
      - instance_id: my-primary-us-central-instance-read-pool
        display_name: "US Central Read Pool Instance"
        instance_type: READ_POOL
        cpu_count: 4

  # セカンダリクラスタの例 (us-east1)
  # source_cluster_key と source_cluster_region でプライマリクラスタにリンクします
  secondary_us_east:
    type: secondary
    region: us-east1
    cluster_id: my-secondary-us-east-cluster
    display_name: "US East Secondary AlloyDB Cluster"
    source_cluster_key: primary_us_central # 上記のプライマリクラスタの論理キー
    source_cluster_region: us-central1 # ソースプライマリクラスタのリージョン
    instances:
      - instance_id: my-secondary-us-east-instance-1
        display_name: "US East Secondary Instance 1"
        instance_type: PRIMARY # セカンダリクラスタにもプライマリインスタンスが必要です
        cpu_count: 2

  # 別のプライマリクラスタの例 (europe-west1)
  primary_europe_west:
    type: primary
    region: europe-west1
    cluster_id: my-primary-europe-west-cluster
    display_name: "Europe West Primary AlloyDB Cluster"
    instances:
      - instance_id: my-primary-europe-west-instance-1
        display_name: "Europe West Primary Instance 1"
        instance_type: PRIMARY
        cpu_count: 2

  # 別のセカンダリクラスタの例 (europe-west2)
  secondary_europe_west_2:
    type: secondary
    region: europe-west2
    cluster_id: my-secondary-europe-west-2-cluster
    display_name: "Europe West 2 Secondary AlloyDB Cluster"
    source_cluster_key: primary_europe_west # 上記のプライマリクラスタの論理キー
    source_cluster_region: europe-west1 # ソースプライマリクラスタのリージョン
    instances:
      - instance_id: my-secondary-europe-west-2-instance-1
        display_name: "Europe West 2 Secondary Instance 1"
        instance_type: PRIMARY
        cpu_count: 2
