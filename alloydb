# main.tf

# Configure the Google Cloud provider
provider "google" {
  project = var.project_id
  # プロバイダのデフォルトリージョンは設定せず、モジュール内で各クラスタのリージョンを指定します
}

# Data source to get the full network self_link
data "google_compute_network" "vpc_network" {
  name    = var.network_name
  project = var.project_id
}

# clusters.yaml ファイルからクラスタ定義を読み込みます
locals {
  cluster_definitions = yamldecode(file("${path.module}/clusters.yaml")).clusters
  primary_clusters    = { for k, v in local.cluster_definitions : k => v if v.type == "primary" }
  secondary_clusters  = { for k, v in local.cluster_definitions : k => v if v.type == "secondary" }

  # すべてのクラスタのインスタンスをフラットなリストに変換
  all_instances = flatten([
    for cluster_key, cluster_def in local.cluster_definitions : [
      for instance_def in cluster_def.instances : {
        cluster_key        = cluster_key
        cluster_id         = cluster_def.cluster_id
        region             = cluster_def.region
        instance_id        = instance_def.instance_id
        display_name       = instance_def.display_name
        instance_type      = instance_def.instance_type
        cpu_count          = lookup(instance_def, "cpu_count", 2) # デフォルト値を提供
        # プライマリクラスタのoutputsからcluster_nameを取得するために、後で参照できるようにする
        source_cluster_name_output_key = cluster_key
      }
    ]
  ])

  # インスタンスを for_each で使用できるようにマップに変換
  # キーは `cluster_key-instance_id` の形式で一意性を確保
  instances_map = { for inst in local.all_instances : "${inst.cluster_key}-${inst.instance_id}" => inst }
}

# プライマリAlloyDBクラスタのモジュール
# clusters.yaml で定義されたすべてのプライマリクラスタに対してループします
module "primary_clusters" {
  source = "./modules/alloydb_cluster"
  for_each = local.primary_clusters

  project_id           = var.project_id
  region               = each.value.region
  cluster_id           = each.value.cluster_id
  cluster_display_name = each.value.display_name
  network              = data.google_compute_network.vpc_network.self_link
  database_version     = var.database_version
  user_password        = var.alloydb_user_password

  # これはプライマリクラスタなので、ソースIDは指定しません
  secondary_cluster_source_id   = null
  secondary_cluster_source_region = null
}

# セカンダリAlloyDBクラスタのモジュール
# clusters.yaml で定義されたすべてのセカンダリクラスタに対してループします
# このモジュールは、レプリケーションを確立するためにプライマリクラスタモジュールの出力に依存します。
module "secondary_clusters" {
  source = "./modules/alloydb_cluster"
  for_each = local.secondary_clusters

  project_id           = var.project_id
  region               = each.value.region
  cluster_id           = each.value.cluster_id
  cluster_display_name = each.value.display_name
  network              = data.google_compute_network.vpc_network.self_link # セカンダリクラスタは同じネットワークを使用します
  database_version     = var.database_version
  user_password        = var.alloydb_user_password

  # レプリケーションのためにプライマリクラスタのIDをソースIDとして設定します
  secondary_cluster_source_id   = module.primary_clusters[each.value.source_cluster_key].cluster_id
  secondary_cluster_source_region = each.value.source_cluster_region # ソースプライマリクラスタのリージョン

  # 明示的な依存関係を定義します（出力による暗黙的な依存関係も機能しますが、明確化のため）
  # これにより、プライマリクラスタが完全に作成されてからセカンダリの作成が試行されます。
  depends_on = [
    module.primary_clusters[each.value.source_cluster_key]
  ]
}

# AlloyDBインスタンスのモジュール
# clusters.yaml で定義されたすべてのインスタンスに対してループします
module "alloydb_instances" {
  source = "./modules/alloydb_instance"
  for_each = local.instances_map

  project_id      = var.project_id
  region          = each.value.region
  cluster_id      = each.value.cluster_id
  instance_id     = each.value.instance_id
  instance_display_name = each.value.display_name
  instance_type   = each.value.instance_type
  cpu_count       = each.value.cpu_count

  # インスタンスが属するクラスタが作成された後にのみインスタンスを作成するように依存関係を設定します。
  # プライマリクラスタのインスタンスの場合
  depends_on = [
    try(module.primary_clusters[each.value.source_cluster_name_output_key], null),
    try(module.secondary_clusters[each.value.source_cluster_name_output_key], null)
  ]
}


output "all_cluster_names" {
  description = "A map of all created AlloyDB cluster names by their logical key."
  value = merge(
    { for k, v in module.primary_clusters : k => v.cluster_name },
    { for k, v in module.secondary_clusters : k => v.cluster_name }
  )
}

output "all_instance_names" {
  description = "A map of all created AlloyDB instance names by their logical key."
  value       = { for k, v in module.alloydb_instances : k => v.instance_name }
}
