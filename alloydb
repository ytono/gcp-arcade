# modules/alloydb_instance/variables.tf

variable "project_id" {
  description = "The ID of the Google Cloud project."
  type        = string
}

variable "region" {
  description = "The region where the AlloyDB instance will be created."
  type        = string
}

variable "cluster_id" {
  description = "The ID of the AlloyDB cluster to which this instance belongs."
  type        = string
}

variable "instance_id" {
  description = "The ID of the AlloyDB instance."
  type        = string
}

variable "instance_display_name" {
  description = "The display name of the AlloyDB instance."
  type        = string
  default     = null
}

variable "instance_type" {
  description = "The type of the instance. Can be PRIMARY or READ_POOL."
  type        = string
  validation {
    condition     = contains(["PRIMARY", "READ_POOL"], upper(var.instance_type))
    error_message = "Instance type must be 'PRIMARY' or 'READ_POOL'."
  }
}

variable "cpu_count" {
  description = "The number of CPUs for the instance."
  type        = number
  default     = 2
}
========================================================================================
# modules/alloydb_instance/main.tf

resource "google_alloydb_instance" "alloydb_instance" {
  project      = var.project_id
  location     = var.region
  cluster      = var.cluster_id
  instance_id  = var.instance_id
  display_name = var.instance_display_name

  instance_type = var.instance_type

  machine_config {
    cpu_count = var.cpu_count
  }

  # Add labels for better organization
  labels = {
    environment = "dev"
    managed_by  = "terraform"
    type        = lower(var.instance_type) # Use instance type as label
  }

  # Deletion protection for the instance
  deletion_protection = false # Set to true for production environments
}
